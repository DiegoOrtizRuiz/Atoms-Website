# Public browser configuration from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical application origin, also allowed in Supabase Auth redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Server-only service credentials. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local seed-only configuration. Use a strong shared demo password outside Git.
DEMO_PASSWORD=
# Optional deterministic anchor for generated activity dates (YYYY-MM-DD).
SEED_REFERENCE_DATE=

# Phase 4: local note enrichment only. Never expose these keys to NEXT_PUBLIC_*.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Phase 16: Google Maps UI + optional geocoding/Census API keys.
# Restrict NEXT_PUBLIC_GOOGLE_MAPS_KEY by HTTP referrer (production domain + localhost)
# and ensure Google Cloud billing is enabled for the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_GEOCODING_KEY=
CENSUS_API_KEY=
CENSUS_ACS_YEAR=2023
